#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

readonly OK=OK
readonly ERR=ERR
readonly EXIT=EXIT

readonly LOCK_FILE_NAME=flake.lock
readonly FLAKE_ROOT=flake.nix
readonly CURRENT_SYSTEM=/run/current-system
readonly SYSTEM_PROFILE=/nix/var/nix/profiles/system

declare -g FLAKE_DIR
declare -g LOCK_FILE
declare -g TMP_LOCK_FILE

function writeline_to_py {
  printf "%s\n" "$1" >&"$SH_PY_FD"
}

function send_ok {
  writeline_to_py $OK
}

function send_err {
  writeline_to_py $ERR
}

function send_result {
  if [[ $? -eq 0 ]]; then
    send_ok
  else
    send_err
  fi
}

function is_git {
  local git_repo=()
  local is_inside_git
  if [ "$1" ]; then
    git_repo=(-C "$1")
  fi

  is_inside_git=$(
    git "${git_repo[@]}" rev-parse --is-inside-work-tree 2>&1 || true
  )

  [[ "$is_inside_git" == "true" ]]
}

function get_git_dir_path {
  local git_repo=()

  if [ "$1" ]; then
    git_repo=(-C "$1")    
  fi

  git "${git_repo[@]}" rev-parse --absolute-git-dir
}

function parse_cmd {
  local args=("$@")

  local cmd="${args[0]}"
  args=("${args[@]:1}")

  case "$cmd" in
    "get_current_system_closure")
      local closure

      closure=$(readlink --canonicalize-existing --no-newline "$CURRENT_SYSTEM")

      writeline_to_py "$closure"
    ;;

    "resolve_flake_dir")
      local dir="${args[0]}"

      FLAKE_DIR=$(readlink --canonicalize-missing --no-newline "$dir")

      if
        [[ -e $FLAKE_DIR && ! -d $FLAKE_DIR ]]
      then
        FLAKE_DIR=$(dirname "$FLAKE_DIR")
      fi

      readonly FLAKE_DIR

      writeline_to_py "$FLAKE_DIR"
    ;;

    "is_dir_flake_exists")
      LOCK_FILE="$FLAKE_DIR/$LOCK_FILE_NAME"
      readonly LOCK_FILE

      test -d "$FLAKE_DIR"
      send_result
    ;;
    
    "is_flake_file_exists")
      local flake_file="$FLAKE_DIR/$FLAKE_ROOT"

      test -e "$flake_file"
      send_result
    ;;
    
    "setup_tmp_lock")
      TMP_LOCK_FILE="$TMP_DIR/$LOCK_FILE_NAME"
      readonly TMP_LOCK_FILE

      if [[ -e "$LOCK_FILE" ]]; then
        cp --reflink=auto -- "$LOCK_FILE" "$TMP_LOCK_FILE"
      fi

      send_ok
    ;;

    "check_nixos_config")
      local out
    
      out=$(nix flake show --no-write-lock-file "$FLAKE_DIR")

      [[ "$out" = *"nixosConfigurations"* ]]
      send_result
    ;;

    "update_lock_file")
      nix flake update \
        --flake "$FLAKE_DIR" \
        --output-lock-file "$TMP_LOCK_FILE"
      send_result
    ;;

    "build")
      local config="${args[0]}"
      local closure
      local -r out_link="$TMP_DIR"/result
      local lock_args=(--no-write-lock-file)

      if [[ -e "$TMP_LOCK_FILE" ]]; then
        lock_args+=(--reference-lock-file "$TMP_LOCK_FILE")
      fi
      
      if 
        nix build --out-link "$out_link" "${lock_args[@]}" "$config"
      then
        closure=$(readlink --canonicalize-existing --no-newline "$out_link")

        send_ok
        writeline_to_py "$closure"
      else
        send_err
      fi
    ;;

    "upgrade")
      local closure="${args[0]}"

      # Ignore all signals which can terminate upgrading and committing
      # shellcheck disable=SC2086
      trap "" $TERM_CORE_SIGS

      (
        # Trap handlers are never inherited by subshells, but
        # ignored signals (see above `trap`) remain ignored in the subshell.
        
        # Closing open file desriptors in the subshell
        # to avoid "File descriptor leaked on lvs invocation" warnings
        # generated by lmv commands that `switch-to-configuration`
        # uses internally
        exec {LOCK_FD}<&-
        exec {PY_SH_FD}<&-
        exec {SH_PY_FD}<&-
        exec {COMMIT_MSG_W_FD}<&-
        exec {COMMIT_MSG_R_FD}<&-

        nix-env --profile "$SYSTEM_PROFILE" --set "$closure" &&
        if [[ -e "$TMP_LOCK_FILE" ]]; then
          cp --update --no-preserve=ownership,mode \
            "$TMP_LOCK_FILE" "$LOCK_FILE"
        fi &&
        "$closure/bin/switch-to-configuration" switch
      )

      send_result
    ;;

    "commit")
      local as_owner=()
      local git=(git -C "$FLAKE_DIR")
      local git_dir
      local repo_owner
      local repo_home="$HOME"

      # Only if the flake is a git repo
      if
        is_git "$FLAKE_DIR"
      then
        # If root then commit as a repo owner
        if
          [ $EUID -eq 0 ]
        then
          git_dir="$(get_git_dir_path "$FLAKE_DIR")"
          repo_owner="$(stat --format="%U" "$git_dir")"
          repo_home="$(getent passwd "$repo_owner" | cut -d: -f6)"

          if [[ -z "$repo_home" ]]; then
            writeline_to_py "ERR_REPO_HOME"
            return
          fi

          as_owner=(runuser -u "$repo_owner" --)
        fi

        if
          HOME="$repo_home" "${as_owner[@]}" "${git[@]}" diff --quiet &&
          HOME="$repo_home" "${as_owner[@]}" "${git[@]}" diff --cached --quiet
        then
          writeline_to_py "NO_CHANGES"
        else
          # --no-commit is the opt-out for committing tracked WIP.
          HOME="$repo_home" "${as_owner[@]}" "${git[@]}" commit \
            --all --file=- <&"$COMMIT_MSG_R_FD"
          send_result
        fi

      else
        writeline_to_py "NOT_GIT"
      fi
    ;;
    
    "exit")
      exit 0
    ;;
    
    *)
      echo "$NAME: privileged-worker: error: unrecognized command"
      exit 1
    ;;
  esac
}

function cleanup {
  if
    [[ "$TMP_DIR" ]]
  then
    rm --recursive "$TMP_DIR"
  fi
}

function on_exit {
  cleanup
  writeline_to_py "$EXIT"
}

function on_error {
  send_err
}

function main {
  trap on_exit EXIT
  trap on_error ERR

  while
    IFS="$CMD_IFS" read -u "$PY_SH_FD" -ra cmd
  do
    # Pong to python for detecting whether
    # the privileged process is running
    writeline_to_py "PONG"

    parse_cmd "${cmd[@]}"
  done
}

main
