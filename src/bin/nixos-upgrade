#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

export PATH="@path@"
export NAME="@name@"
export VERSION="@version@"

function get_term_core_default_action_sigs {
  local sigs=(
    SIGHUP SIGINT SIGQUIT SIGUSR1 SIGUSR2 SIGTERM SIGPIPE SIGXCPU SIGXFSZ SIGALRM
  )
  local signums=()
  local signum

  for signum in "${sigs[@]}"; do
    signums+=("$(kill -l "$signum")")
  done

  printf '%s' "${signums[*]}"
}

function array_to_csv {
  printf '%s' "${1// /,}"
}

TERM_CORE_SIGS="$(get_term_core_default_action_sigs)"
export TERM_CORE_SIGS

function main {
  local py_opts=(@py_opts@)
  # Keep signals pending until Python installs its handlers; otherwise, an
  # early signal could take its default action during interpreter startup.
  exec env --block-signal="$(array_to_csv "$TERM_CORE_SIGS")" \
    python "${py_opts[@]}" "@pyfile@" "$@"
}

main "$@"
